# Copy this file to ".env" and fill in real values.

# --- OpenAI (AI Assistant feature) -------------------------------------
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini

# --- Data source mode ----------------------------------------------------
# "excel" = manual Inventory/Marketing template only (Shopee order/income
#           Excel upload was replaced by the live Shopee API below)
# "plugo" = live Plugo REST API sync every N minutes only
# "both"  = Plugo auto-sync running AND the manual template both active -
#           whichever synced/imported most recently wins per module for a
#           shared SKU (see data_sources table / Data Reliability page).
DATA_SOURCE_MODE=excel

# --- Plugo REST API (only used when DATA_SOURCE_MODE=plugo/both) --------
# Base URL confirmed real: api.plugo.world (NOT api.plugo.co, which never
# existed). Get PLUGO_API_KEY/PLUGO_VENDOR_ID from
# https://admin.plugo.world/preferences/integrations - as of this writing
# they're pending approval from Plugo's admin, see README "Setup Plugo API".
PLUGO_BASE_URL=https://api.plugo.world
PLUGO_API_KEY=
PLUGO_VENDOR_ID=
PLUGO_USE_MOCK_DATA=True
PLUGO_SYNC_INTERVAL_MINUTES=10

# --- Shopee Open Platform API v2 (semi real-time sync, hourly) ----------
# Cara dapat SHOPEE_PARTNER_ID & SHOPEE_PARTNER_KEY:
#   1. Buka https://open.shopee.com/ -> daftar sebagai Partner (pakai akun
#      Shopee toko kamu, atau akun yang punya akses admin ke toko itu).
#   2. Di Partner Portal: App Management -> Create App (pilih tipe app untuk
#      toko sendiri, bukan public/ISV app kalau cuma untuk 1 toko).
#   3. Setelah app dibuat, Partner ID dan Partner Key muncul di halaman detail
#      app itu - salin ke dua variabel di bawah.
#   4. Di pengaturan app yang sama, daftarkan Redirect URL / Authorized
#      Redirect - HARUS PERSIS SAMA dengan SHOPEE_REDIRECT_URL di bawah, atau
#      Shopee akan menolak proses connect.
# SHOPEE_SHOP_ID TIDAK diisi manual di sini - otomatis didapat & disimpan ke
# database saat kamu klik "Connect Shopee" di halaman Import Data (access
# token & refresh token juga tersimpan di database, bukan di file ini, karena
# rotasinya otomatis tiap beberapa jam).
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
# Ganti dengan URL halaman Import Data kamu yang sebenarnya (localhost untuk
# testing lokal, atau domain HTTPS asli kalau sudah di-deploy) - buka halaman
# Import Data di browser dan salin persis dari address bar.
SHOPEE_REDIRECT_URL=http://localhost:8501/Import_Data
# Status app di Shopee Open Platform Console (App Management) menentukan host
# yang benar - partner_id/key hanya valid di host yang SAMA statusnya. Cara
# paling akurat cari host yang benar: buka Tools -> API Test Tool di console
# Shopee kamu, pilih API apa saja, lihat dropdown "Request URL" - itu host
# yang benar-benar terverifikasi untuk app kamu (jangan asumsi dari dokumentasi
# umum/pihak ketiga, host sandbox pernah salah diasumsikan sebagai
# partner.test-stable.shopeemobile.com padahal yang benar berbeda per region):
#   status "Developing" (sandbox/test) -> https://openplatform.sandbox.test-stable.shopee.sg
#     (untuk region SEA - ada juga varian .shopee.cn untuk region lain, pilih
#     sesuai yang tertera di API Test Tool kamu)
#   status "Live" (setelah di-approve Shopee) -> https://partner.shopeemobile.com
#     (terverifikasi empiris 2026-09-21 lewat request bertanda tangan sengaja
#     salah - respons "error_sign" bukan "invalid_partner_id" membuktikan host
#     ini cocok dengan Live Partner ID). Pastikan juga SHOPEE_PARTNER_ID/
#     SHOPEE_PARTNER_KEY pakai nilai "Live" dari App Management, bukan "Test".
SHOPEE_API_HOST=https://partner.shopeemobile.com
SHOPEE_SYNC_INTERVAL_MINUTES=60

# --- Alert thresholds (tune with the GM) --------------------------------
LOW_STOCK_THRESHOLD_UNITS=10
LOW_STOCK_DAYS_TO_STOCKOUT=7
STALE_DATA_HOURS=24
LOW_ROAS_THRESHOLD=1.5
SALES_SPIKE_MULTIPLIER=2.0

# --- Database (Turso - hosted, persistent) -------------------------------
# Local SQLite on Streamlit Community Cloud gets wiped on every container
# restart/redeploy - the database now lives on Turso instead, so data (and
# the Shopee OAuth token) survives restarts.
#   1. Sign up at https://turso.tech/ (free tier is fine for this scale).
#   2. Create a database (any name, e.g. "pospicc").
#   3. On the database's detail page: copy the URL into TURSO_DATABASE_URL
#      below (starts with libsql://...).
#   4. Click "Create Token" (or run `turso db tokens create <db-name>` via
#      their CLI) and paste the token into TURSO_AUTH_TOKEN below.
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=
